{
  "name": "docubrew",
  "version": "0.9.0",
  "description": "Markdown + reusable CSS Blends → print-ready PDFs, with a live browser preview.",
  "main": "src/server/server.js",
  "scripts": {
    "start": "node bin/docubrew.js",
    "build": "node bin/docubrew.js build",
    "dev": "node --watch-path=src bin/docubrew.js --no-open",
    "build:vendor": "node scripts/build-vendor.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshKoiro/DocuBrew.git"
  },
  "keywords": [
    "markdown",
    "pdf",
    "pagedjs",
    "print",
    "css"
  ],
  "author": "Josh Koiro",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/JoshKoiro/DocuBrew/issues"
  },
  "homepage": "https://github.com/JoshKoiro/DocuBrew#readme",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "chokidar": "^6.0.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.3",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "pagedjs": "^0.4.3",
    "puppeteer": "^25.17.0",
    "ws": "^8.22.2",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "bin": {
    "docubrew": "bin/docubrew.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  }
}
